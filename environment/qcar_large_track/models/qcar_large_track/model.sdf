<?xml version="1.0"?>

<sdf version="1.7">
  <model name="qcar_large_track">

    <!-- The model is static (does not move) -->
    <static>true</static>

    <link name="track">

      <!-- Collision geometry for the track -->
      <collision name="collision">
        <pose>0 0 -0.01 0 0 0</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>4.88 6.2</size>
          </plane>
        </geometry>
      </collision>

      <!-- Visual geometry for the track -->
      <visual name="visual">
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>4.88 6.2</size>
          </plane>
        </geometry>

        <material>
          <script>
            <uri>model://qcar_large_track/materials/scripts</uri>
            <uri>model://qcar_large_track/materials/textures</uri>
            <name>QCar/SDCS_Map</name>
          </script>
        </material>

      </visual>

    </link>

  </model>
</sdf>