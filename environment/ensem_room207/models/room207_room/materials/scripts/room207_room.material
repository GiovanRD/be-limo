// Generated by scripts/generate_room.py: edit the script, not this file.

// Ceiling seen only from below: the plane faces up and the culling is
// inverted, so the Gazebo GUI camera above the room still sees inside.
// The ceiling is lit by the lamps below it, approximated with emissive.
material Room207/Ceiling
{
  technique
  {
    pass
    {
      cull_hardware anticlockwise
      cull_software none
      ambient 0.5 0.5 0.5
      diffuse 0 0 0
      emissive 0.55 0.55 0.54
    }
  }
}

