<?xml version="1.0"?>
<!--
  BE LIMO - simulation world for deliverable 2.
  QCar large track (frame centred on the mat, as in qcar_large_track) with:
    - 4 traffic lights at the central crossing (switched on by traffic_light_manager).
      Each light stands on the far right corner of the crossing for the vehicles
      it controls (light "west" = for the vehicles coming from the west, node 9),
    - 1 stop sign before the roundabout (approach from node 14),
    - 1 obstacle on the top lane (between nodes 20 and 22).
  Coordinates match be_limo/roadmap.py.
-->
<sdf version="1.7">
  <world name="be_limo_track">

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://qcar_large_track</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <gui>
      <camera name="user_camera">
        <pose>0 -0.2 8.5 0 1.5707 1.5707</pose>
      </camera>
    </gui>

    <model name="traffic_light_west">
      <static>true</static>
      <pose>0.54 -1.21 0 0 0 3.1416</pose>
      <link name="link">
        <collision name="pole_collision"><pose>0 0 0.15 0 0 0</pose><geometry><cylinder><radius>0.012</radius><length>0.30</length></cylinder></geometry></collision>
        <visual name="pole"><pose>0 0 0.15 0 0 0</pose><geometry><cylinder><radius>0.012</radius><length>0.30</length></cylinder></geometry><material><ambient>0.08 0.08 0.09 1</ambient><diffuse>0.08 0.08 0.09 1</diffuse></material></visual>
        <visual name="base"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.08 0.08 0.01</size></box></geometry><material><ambient>0.08 0.08 0.09 1</ambient><diffuse>0.08 0.08 0.09 1</diffuse></material></visual>
        <collision name="head_collision"><pose>0 0 0.375 0 0 0</pose><geometry><box><size>0.08 0.08 0.16</size></box></geometry></collision>
        <visual name="head"><pose>0 0 0.375 0 0 0</pose><geometry><box><size>0.08 0.08 0.16</size></box></geometry><material><ambient>0.06 0.06 0.07 1</ambient><diffuse>0.06 0.06 0.07 1</diffuse></material></visual>
        <visual name="red_off"><pose>0.041 0 0.42 0 1.5708 0</pose><geometry><cylinder><radius>0.017</radius><length>0.004</length></cylinder></geometry><material><ambient>0.25 0.02 0.02 1</ambient><diffuse>0.25 0.02 0.02 1</diffuse></material></visual>
        <visual name="amber_off"><pose>0.041 0 0.375 0 1.5708 0</pose><geometry><cylinder><radius>0.017</radius><length>0.004</length></cylinder></geometry><material><ambient>0.25 0.15 0.02 1</ambient><diffuse>0.25 0.15 0.02 1</diffuse></material></visual>
        <visual name="green_off"><pose>0.041 0 0.33 0 1.5708 0</pose><geometry><cylinder><radius>0.017</radius><length>0.004</length></cylinder></geometry><material><ambient>0.02 0.2 0.04 1</ambient><diffuse>0.02 0.2 0.04 1</diffuse></material></visual>
      </link>
    </model>
    <model name="traffic_light_east">
      <static>true</static>
      <pose>-0.51 -0.26 0 0 0 0.0000</pose>
      <link name="link">
        <collision name="pole_collision"><pose>0 0 0.15 0 0 0</pose><geometry><cylinder><radius>0.012</radius><length>0.30</length></cylinder></geometry></collision>
        <visual name="pole"><pose>0 0 0.15 0 0 0</pose><geometry><cylinder><radius>0.012</radius><length>0.30</length></cylinder></geometry><material><ambient>0.08 0.08 0.09 1</ambient><diffuse>0.08 0.08 0.09 1</diffuse></material></visual>
        <visual name="base"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.08 0.08 0.01</size></box></geometry><material><ambient>0.08 0.08 0.09 1</ambient><diffuse>0.08 0.08 0.09 1</diffuse></material></visual>
        <collision name="head_collision"><pose>0 0 0.375 0 0 0</pose><geometry><box><size>0.08 0.08 0.16</size></box></geometry></collision>
        <visual name="head"><pose>0 0 0.375 0 0 0</pose><geometry><box><size>0.08 0.08 0.16</size></box></geometry><material><ambient>0.06 0.06 0.07 1</ambient><diffuse>0.06 0.06 0.07 1</diffuse></material></visual>
        <visual name="red_off"><pose>0.041 0 0.42 0 1.5708 0</pose><geometry><cylinder><radius>0.017</radius><length>0.004</length></cylinder></geometry><material><ambient>0.25 0.02 0.02 1</ambient><diffuse>0.25 0.02 0.02 1</diffuse></material></visual>
        <visual name="amber_off"><pose>0.041 0 0.375 0 1.5708 0</pose><geometry><cylinder><radius>0.017</radius><length>0.004</length></cylinder></geometry><material><ambient>0.25 0.15 0.02 1</ambient><diffuse>0.25 0.15 0.02 1</diffuse></material></visual>
        <visual name="green_off"><pose>0.041 0 0.33 0 1.5708 0</pose><geometry><cylinder><radius>0.017</radius><length>0.004</length></cylinder></geometry><material><ambient>0.02 0.2 0.04 1</ambient><diffuse>0.02 0.2 0.04 1</diffuse></material></visual>
      </link>
    </model>
    <model name="traffic_light_north">
      <static>true</static>
      <pose>-0.51 -1.21 0 0 0 1.5708</pose>
      <link name="link">
        <collision name="pole_collision"><pose>0 0 0.15 0 0 0</pose><geometry><cylinder><radius>0.012</radius><length>0.30</length></cylinder></geometry></collision>
        <visual name="pole"><pose>0 0 0.15 0 0 0</pose><geometry><cylinder><radius>0.012</radius><length>0.30</length></cylinder></geometry><material><ambient>0.08 0.08 0.09 1</ambient><diffuse>0.08 0.08 0.09 1</diffuse></material></visual>
        <visual name="base"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.08 0.08 0.01</size></box></geometry><material><ambient>0.08 0.08 0.09 1</ambient><diffuse>0.08 0.08 0.09 1</diffuse></material></visual>
        <collision name="head_collision"><pose>0 0 0.375 0 0 0</pose><geometry><box><size>0.08 0.08 0.16</size></box></geometry></collision>
        <visual name="head"><pose>0 0 0.375 0 0 0</pose><geometry><box><size>0.08 0.08 0.16</size></box></geometry><material><ambient>0.06 0.06 0.07 1</ambient><diffuse>0.06 0.06 0.07 1</diffuse></material></visual>
        <visual name="red_off"><pose>0.041 0 0.42 0 1.5708 0</pose><geometry><cylinder><radius>0.017</radius><length>0.004</length></cylinder></geometry><material><ambient>0.25 0.02 0.02 1</ambient><diffuse>0.25 0.02 0.02 1</diffuse></material></visual>
        <visual name="amber_off"><pose>0.041 0 0.375 0 1.5708 0</pose><geometry><cylinder><radius>0.017</radius><length>0.004</length></cylinder></geometry><material><ambient>0.25 0.15 0.02 1</ambient><diffuse>0.25 0.15 0.02 1</diffuse></material></visual>
        <visual name="green_off"><pose>0.041 0 0.33 0 1.5708 0</pose><geometry><cylinder><radius>0.017</radius><length>0.004</length></cylinder></geometry><material><ambient>0.02 0.2 0.04 1</ambient><diffuse>0.02 0.2 0.04 1</diffuse></material></visual>
      </link>
    </model>
    <model name="traffic_light_south">
      <static>true</static>
      <pose>0.54 -0.26 0 0 0 -1.5708</pose>
      <link name="link">
        <collision name="pole_collision"><pose>0 0 0.15 0 0 0</pose><geometry><cylinder><radius>0.012</radius><length>0.30</length></cylinder></geometry></collision>
        <visual name="pole"><pose>0 0 0.15 0 0 0</pose><geometry><cylinder><radius>0.012</radius><length>0.30</length></cylinder></geometry><material><ambient>0.08 0.08 0.09 1</ambient><diffuse>0.08 0.08 0.09 1</diffuse></material></visual>
        <visual name="base"><pose>0 0 0.005 0 0 0</pose><geometry><box><size>0.08 0.08 0.01</size></box></geometry><material><ambient>0.08 0.08 0.09 1</ambient><diffuse>0.08 0.08 0.09 1</diffuse></material></visual>
        <collision name="head_collision"><pose>0 0 0.375 0 0 0</pose><geometry><box><size>0.08 0.08 0.16</size></box></geometry></collision>
        <visual name="head"><pose>0 0 0.375 0 0 0</pose><geometry><box><size>0.08 0.08 0.16</size></box></geometry><material><ambient>0.06 0.06 0.07 1</ambient><diffuse>0.06 0.06 0.07 1</diffuse></material></visual>
        <visual name="red_off"><pose>0.041 0 0.42 0 1.5708 0</pose><geometry><cylinder><radius>0.017</radius><length>0.004</length></cylinder></geometry><material><ambient>0.25 0.02 0.02 1</ambient><diffuse>0.25 0.02 0.02 1</diffuse></material></visual>
        <visual name="amber_off"><pose>0.041 0 0.375 0 1.5708 0</pose><geometry><cylinder><radius>0.017</radius><length>0.004</length></cylinder></geometry><material><ambient>0.25 0.15 0.02 1</ambient><diffuse>0.25 0.15 0.02 1</diffuse></material></visual>
        <visual name="green_off"><pose>0.041 0 0.33 0 1.5708 0</pose><geometry><cylinder><radius>0.017</radius><length>0.004</length></cylinder></geometry><material><ambient>0.02 0.2 0.04 1</ambient><diffuse>0.02 0.2 0.04 1</diffuse></material></visual>
      </link>
    </model>

    <model name="stop_sign">
      <static>true</static>
      <pose>2.36 1.75 0 0 0 -1.5708</pose>
      <link name="link">
        <collision name="pole_collision"><pose>0 0 0.15 0 0 0</pose><geometry><cylinder><radius>0.01</radius><length>0.30</length></cylinder></geometry></collision>
        <visual name="pole"><pose>0 0 0.15 0 0 0</pose><geometry><cylinder><radius>0.01</radius><length>0.30</length></cylinder></geometry><material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material></visual>
        <visual name="border"><pose>0.012 0 0.30 0 1.5708 0</pose><geometry><cylinder><radius>0.08</radius><length>0.004</length></cylinder></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse><emissive>0.4 0.4 0.4 1</emissive></material></visual>
        <visual name="red"><pose>0.015 0 0.30 0 1.5708 0</pose><geometry><cylinder><radius>0.05</radius><length>0.004</length></cylinder></geometry><material><ambient>0.85 0.02 0.02 1</ambient><diffuse>0.85 0.02 0.02 1</diffuse><emissive>0.5 0 0 1</emissive></material></visual>
      </link>
    </model>

    <model name="obstacle_box">
      <static>true</static>
      <pose>-0.70 2.795 0.075 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 0.12 0.15</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 0.12 0.15</size></box></geometry><material><ambient>0.9 0.45 0.05 1</ambient><diffuse>0.9 0.45 0.05 1</diffuse></material></visual>
      </link>
    </model>

  </world>
</sdf>
