<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">

  <name>room207_limo</name>
  <version>0.0.1</version>

  <description>
    Gazebo and RViz simulation environment and integrated
    teleoperation and recording GUI for the AgileX LIMO
    in ENSEM Room 207.
  </description>

  <maintainer email="jeremie.kreiss@univ-lorraine.fr">
    Jérémie Kreiss
  </maintainer>

  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Launch and simulation -->
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>limo_car</exec_depend>
  <exec_depend>ensem_room207</exec_depend>
  <exec_depend>qcar_large_track</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- Teleoperation and recording GUI -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>teleoperation</exec_depend>
  <exec_depend>recording</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-tk</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- ImageTk is provided by the Ubuntu package python3-pil.imagetk (no rosdep key). -->
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <!-- Odometry plotting -->
  <exec_depend>nav_msgs</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>